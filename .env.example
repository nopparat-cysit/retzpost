# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/retzpost?schema=public"

# App & Auth
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="super-secret-session-key-at-least-32-chars-long"

# Envelope Encryption (TokenVaultService)
# JSON map of key versions. Keys must be 32 bytes (64 hex characters or 44 base64 characters)
ENCRYPTION_KEYS_JSON='{"v1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}'
ENCRYPTION_PRIMARY_VERSION="v1"

# Object Storage (Local MinIO or Cloudflare R2 / AWS S3)
STORAGE_PROVIDER="s3" # "s3" or "r2"
STORAGE_ENDPOINT="http://localhost:9000" # Leave empty for AWS S3; use Cloudflare R2 endpoint in prod
STORAGE_REGION="auto"
STORAGE_BUCKET="retzpost-assets"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadminpassword"
STORAGE_PUBLIC_DOMAIN="" # Optional CDN domain if configured

# Google / YouTube OAuth
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/connections/youtube/callback"

# TikTok Open API v2
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="http://localhost:3000/api/connections/tiktok/callback"
TIKTOK_WEBHOOK_SECRET="your-tiktok-webhook-secret"
