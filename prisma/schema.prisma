generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  name            String?
  avatarUrl       String?        @map("avatar_url")
  passwordHash    String?        @map("password_hash")
  systemRole      SystemRole     @default(USER) @map("system_role")
  status          AccountStatus  @default(ACTIVE)
  pdpaConsentedAt DateTime?      @map("pdpa_consented_at") @db.Timestamptz(6)
  lastLoginIp     String?        @map("last_login_ip")
  masterTokenBalance Int         @default(50) @map("master_token_balance")
  activePlanTier  PlanTier       @default(STARTER) @map("active_plan_tier")
  trialStartedAt  DateTime?      @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt     DateTime?      @map("trial_ends_at") @db.Timestamptz(6)
  promoEligible   Boolean        @default(true) @map("promo_eligible")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditEvents     AuditEvent[]
  memberships     Membership[]
  publishBatches  PublishBatch[]
  dsarRequests    DsarRequest[]

  @@map("users")
}

model Workspace {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String                @unique
  defaultTimezone      String                @default("Asia/Bangkok") @map("default_timezone")
  planTier             PlanTier              @default(STARTER) @map("plan_tier")
  billingCycle         String                @default("MONTHLY") @map("billing_cycle")
  tokenBalance         Int                   @default(50) @map("token_balance")
  themePreset          ThemePreset           @default(NEWSPRINT) @map("theme_preset")
  maxRetryAttempts     Int                   @default(4) @map("max_retry_attempts")
  autoFrameStories     Boolean               @default(true) @map("auto_frame_stories")
  emailAlertsOnFailure Boolean               @default(true) @map("email_alerts_on_failure")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditEvents          AuditEvent[]
  contentEditions      ContentEdition[]
  contents             Content[]
  mediaAssets          MediaAsset[]
  memberships          Membership[]
  platformAccounts     PlatformAccount[]
  publications         PlatformPublication[]
  publishBatches       PublishBatch[]
  publishJobs          PublishJob[]
  connections          SocialConnection[]
  subscriptionInvoices SubscriptionInvoice[]
  tokenTransactions    TokenTransaction[]

  @@map("workspaces")
}

model Membership {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        Role      @default(OWNER)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model SocialConnection {
  id                    String            @id @default(uuid()) @db.Uuid
  workspaceId           String            @map("workspace_id") @db.Uuid
  platform              Platform
  providerUserId        String            @map("provider_user_id")
  encryptedAccessToken  String            @map("encrypted_access_token")
  encryptedRefreshToken String?           @map("encrypted_refresh_token")
  keyVersion            String            @default("v1") @map("key_version")
  accessTokenExpiresAt  DateTime?         @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime?         @map("refresh_token_expires_at") @db.Timestamptz(6)
  grantedScopes         Json              @default("[]") @map("granted_scopes")
  status                ConnectionStatus  @default(ACTIVE)
  lastError             String?           @map("last_error")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  platformAccounts      PlatformAccount[]
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, providerUserId])
  @@index([workspaceId, platform])
  @@map("social_connections")
}

model PlatformAccount {
  id                    String                @id @default(uuid()) @db.Uuid
  workspaceId           String                @map("workspace_id") @db.Uuid
  connectionId          String                @map("connection_id") @db.Uuid
  platform              Platform
  providerAccountId     String                @map("provider_account_id")
  handle                String
  displayName           String                @map("display_name")
  avatarUrl             String?               @map("avatar_url")
  capabilitiesCache     Json?                 @map("capabilities_cache")
  capabilitiesFetchedAt DateTime?             @map("capabilities_fetched_at") @db.Timestamptz(6)
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  contentEditions       ContentEdition[]
  connection            SocialConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publications          PlatformPublication[]
  publishJobs           PublishJob[]

  @@unique([workspaceId, platform, providerAccountId])
  @@index([workspaceId, platform])
  @@map("platform_accounts")
}

model MediaAsset {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  mediaType         MediaType          @default(VIDEO) @map("media_type")
  storageKey        String             @unique @map("storage_key")
  posterStorageKey  String?            @map("poster_storage_key")
  originalFilename  String             @map("original_filename")
  mimeType          String             @map("mime_type")
  sizeBytes         BigInt             @map("size_bytes")
  sha256Checksum    String?            @map("sha256_checksum")
  durationSec       Decimal?           @map("duration_sec") @db.Decimal(10, 3)
  width             Int?
  height            Int?
  aspectRatio       String?            @map("aspect_ratio")
  videoCodec        String?            @map("video_codec")
  audioCodec        String?            @map("audio_codec")
  status            AssetStatus        @default(UPLOADING)
  rejectionReason   String?            @map("rejection_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  contentMediaItems ContentMediaItem[]
  contents          Content[]
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("media_assets")
}

model Content {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  postFormat        PostFormat         @default(FEED_POST) @map("post_format")
  primaryAssetId    String?            @map("primary_asset_id") @db.Uuid
  workingTitle      String             @default("Untitled Story") @map("working_title")
  sharedCaption     String?            @map("shared_caption")
  sharedDescription String?            @map("shared_description")
  sharedTags        Json               @default("[]") @map("shared_tags")
  status            ContentStatus      @default(DRAFT)
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  editions          ContentEdition[]
  mediaItems        ContentMediaItem[]
  primaryAsset      MediaAsset?        @relation(fields: [primaryAssetId], references: [id])
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishBatches    PublishBatch[]
  publishJobs       PublishJob[]

  @@index([workspaceId, status, updatedAt(sort: Desc)])
  @@map("contents")
}

model ContentMediaItem {
  id         String     @id @default(uuid()) @db.Uuid
  contentId  String     @map("content_id") @db.Uuid
  assetId    String     @map("asset_id") @db.Uuid
  orderIndex Int        @default(0) @map("order_index")
  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  content    Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, orderIndex])
  @@index([contentId])
  @@map("content_media_items")
}

model ContentEdition {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  contentId         String          @map("content_id") @db.Uuid
  platformAccountId String          @map("platform_account_id") @db.Uuid
  platform          Platform
  overriddenFields  Json            @default("[]") @map("overridden_fields")
  editionPayload    Json            @default("{}") @map("edition_payload")
  isValid           Boolean         @default(true) @map("is_valid")
  validationIssues  Json            @default("[]") @map("validation_issues")
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  content           Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([contentId, platformAccountId])
  @@index([workspaceId, contentId])
  @@map("content_editions")
}

model PublishBatch {
  id                     String               @id @default(uuid()) @db.Uuid
  workspaceId            String               @map("workspace_id") @db.Uuid
  contentId              String               @map("content_id") @db.Uuid
  requestedByUserId      String?              @map("requested_by_user_id") @db.Uuid
  idempotencyKey         String               @map("idempotency_key")
  mode                   PublishMode          @default(PUBLISH_NOW)
  requestedTimezone      String               @default("Asia/Bangkok") @map("requested_timezone")
  requestedLocalWallTime String?              @map("requested_local_wall_time")
  scheduledForUtc        DateTime?            @map("scheduled_for_utc") @db.Timestamptz(6)
  aggregateStatus        BatchAggregateStatus @default(PENDING) @map("aggregate_status")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  content                Content              @relation(fields: [contentId], references: [id], onDelete: Cascade)
  requestedByUser        User?                @relation(fields: [requestedByUserId], references: [id])
  workspace              Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs                   PublishJob[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, aggregateStatus, createdAt(sort: Desc)])
  @@map("publish_batches")
}

model PublishJob {
  id                   String               @id @default(uuid()) @db.Uuid
  workspaceId          String               @map("workspace_id") @db.Uuid
  batchId              String               @map("batch_id") @db.Uuid
  contentId            String               @map("content_id") @db.Uuid
  platformAccountId    String               @map("platform_account_id") @db.Uuid
  platform             Platform
  targetFormat         PostFormat           @default(FEED_POST) @map("target_format")
  frozenPayload        Json                 @map("frozen_payload")
  scheduledForUtc      DateTime?            @map("scheduled_for_utc") @db.Timestamptz(6)
  status               JobStatus            @default(QUEUED)
  attemptCount         Int                  @default(0) @map("attempt_count")
  maxAttempts          Int                  @default(4) @map("max_attempts")
  nextRetryAt          DateTime?            @map("next_retry_at") @db.Timestamptz(6)
  lastErrorCode        String?              @map("last_error_code")
  lastErrorSafeMessage String?              @map("last_error_safe_message")
  lockToken            String?              @map("lock_token")
  lockedUntil          DateTime?            @map("locked_until") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  publication          PlatformPublication?
  attempts             PublishAttempt[]
  batch                PublishBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  content              Content              @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platformAccount      PlatformAccount      @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([batchId, platformAccountId])
  @@index([workspaceId, status, scheduledForUtc])
  @@index([contentId, platformAccountId])
  @@map("publish_jobs")
}

model PublishAttempt {
  id                   String         @id @default(uuid()) @db.Uuid
  jobId                String         @map("job_id") @db.Uuid
  attemptNumber        Int            @map("attempt_number")
  startedAt            DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt           DateTime?      @map("finished_at") @db.Timestamptz(6)
  remoteSessionUri     String?        @map("remote_session_uri")
  bytesUploaded        BigInt         @default(0) @map("bytes_uploaded")
  errorCategory        ErrorCategory? @map("error_category")
  rawProviderCode      String?        @map("raw_provider_code")
  sanitizedDiagnostics Json?          @map("sanitized_diagnostics")
  job                  PublishJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, attemptNumber])
  @@map("publish_attempts")
}

model PlatformPublication {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  jobId             String          @unique @map("job_id") @db.Uuid
  platformAccountId String          @map("platform_account_id") @db.Uuid
  platform          Platform
  remotePostId      String          @map("remote_post_id")
  remotePermalink   String          @map("remote_permalink")
  remoteVisibility  String          @default("public") @map("remote_visibility")
  publishedAt       DateTime        @default(now()) @map("published_at") @db.Timestamptz(6)
  clicksCount       Int             @default(0) @map("clicks_count")
  commentsCount     Int             @default(0) @map("comments_count")
  lastSyncedAt      DateTime?       @map("last_synced_at") @db.Timestamptz(6)
  likesCount        Int             @default(0) @map("likes_count")
  sharesCount       Int             @default(0) @map("shares_count")
  syncCadenceTier   String          @default("HOT") @map("sync_cadence_tier")
  syncErrorMessage  String?         @map("sync_error_message")
  syncStatus        String          @default("IDLE") @map("sync_status")
  viewsCount        BigInt          @default(0) @map("views_count")
  job               PublishJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, platform, remotePostId])
  @@index([workspaceId, syncCadenceTier, lastSyncedAt])
  @@map("platform_publications")
}

model AuditEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  action      String
  resource    String
  details     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("audit_events")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    Platform
  eventId     String    @map("event_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  isProcessed Boolean   @default(false) @map("is_processed")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model SubscriptionInvoice {
  id                  String        @id @default(uuid()) @db.Uuid
  workspaceId         String        @map("workspace_id") @db.Uuid
  planTier            PlanTier      @map("plan_tier")
  billingCycle        String        @default("MONTHLY") @map("billing_cycle")
  amountThb           Int           @map("amount_thb")
  vatAmountThb        Int           @default(0) @map("vat_amount_thb")
  totalAmountThb      Int           @map("total_amount_thb")
  paymentMethod       PaymentMethod @default(PROMPTPAY) @map("payment_method")
  paymentStatus       PaymentStatus @default(PENDING) @map("payment_status")
  promptPaySlipUrl    String?       @map("promptpay_slip_url")
  taxInvoiceRequested Boolean       @default(false) @map("tax_invoice_requested")
  companyName         String?       @map("company_name")
  taxId               String?       @map("tax_id")
  branchId            String?       @default("00000") @map("branch_id")
  companyAddress      String?       @map("company_address")
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, paymentStatus])
  @@map("subscription_invoices")
}

model TokenTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  actorName    String?  @map("actor_name")
  actionKey    String?  @map("action_key")
  amount       Int
  type         String
  description  String
  balanceAfter Int      @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("token_transactions")
}

model DsarRequest {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  requestType DsarRequestType @map("request_type")
  status      DsarStatus      @default(PENDING)
  reason      String?
  notes       String?
  resultUrl   String?         @map("result_url")
  requestedAt DateTime        @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("dsar_requests")
}

enum SystemRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum PlanTier {
  STARTER
  SOLO
  CREATOR
  STUDIO_PRO
  AGENCY
}

enum ThemePreset {
  NEWSPRINT
  MIDNIGHT
  MATCHA
  TERRACOTTA
  INDIGO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  VERIFIED
  REJECTED
  REFUNDED
  TRIAL_ACTIVE
}

enum PaymentMethod {
  PROMPTPAY
  CREDIT_CARD
}

enum DsarRequestType {
  EXPORT_DATA
  DELETE_ACCOUNT
  REVOKE_CONSENT
}

enum DsarStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  FACEBOOK
}

enum PostFormat {
  FEED_POST
  STORY
  VIDEO_REEL
}

enum MediaType {
  VIDEO
  IMAGE
}

enum ConnectionStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  REVOKED
  ERROR
}

enum AssetStatus {
  UPLOADING
  VALIDATING
  READY
  REJECTED
  DELETED
}

enum ContentStatus {
  DRAFT
  READY
  ARCHIVED
}

enum PublishMode {
  PUBLISH_NOW
  SCHEDULED
}

enum BatchAggregateStatus {
  PENDING
  IN_PROGRESS
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELLED
}

enum JobStatus {
  SCHEDULED
  QUEUED
  UPLOADING
  PROCESSING
  PUBLISHED
  SENT_TO_INBOX
  FAILED_RETRYABLE
  FAILED_FINAL
  UNKNOWN_RECONCILE
  CANCELLED
}

enum ErrorCategory {
  TRANSIENT_NETWORK
  RATE_LIMIT_OR_QUOTA
  AUTH_OR_PERMISSION
  VALIDATION_OR_MEDIA
  POLICY_OR_MODERATION
  UNKNOWN_OUTCOME
}
